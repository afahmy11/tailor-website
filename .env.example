# ---------- App ----------
NODE_ENV=production
# Public site URL (used by Auth.js + emails). Use https when behind the proxy.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
# 32-byte base64 key for encrypting PII at rest. openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# ---------- Database ----------
POSTGRES_USER=abaya
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=abaya
# App connects over the compose network to the "db" service.
DATABASE_URL=postgresql://abaya:change-me-strong-password@db:5432/abaya?schema=public

# ---------- Email (SMTP) ----------
# In dev this points at the Mailpit container. Swap for any provider in prod.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=no-reply@atelier-abaya.local

# ---------- Admin ----------
# Comma-separated emails granted admin access on first login.
ADMIN_EMAILS=admin@example.com

# ---------- Business ----------
# WhatsApp number in international format, digits only (e.g. 9715xxxxxxx)
WHATSAPP_NUMBER=971500000000
CURRENCY=AED

# ---------- Payment (pluggable, decide later) ----------
# Options: manual | stripe   (manual = no gateway, order placed as "awaiting payment")
PAYMENT_PROVIDER=manual
# Stripe (only needed if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
